NODE_ENV=development
PORT=3005
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
LOG_LEVEL=debug

# Max discoverable radius in meters (hard cap regardless of what client requests)
BT_MAX_RADIUS_M=200
# Default radius if client doesn't specify
BT_DEFAULT_RADIUS_M=50
# Seconds before a user's presence expires if they stop beaconing
BT_PRESENCE_TTL_S=45
